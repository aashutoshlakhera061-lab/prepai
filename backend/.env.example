# Copy this file to .env and fill in real values.

# ── Choose ONE provider ──────────────────────────────────────────────
# LLM_PROVIDER = anthropic | groq | openrouter
LLM_PROVIDER=anthropic

# ── Model id — depends on which provider you picked above ───────────
# anthropic:   claude-sonnet-4-6 (recommended) or claude-opus-4-6 (higher quality/cost)
# groq:        openai/gpt-oss-120b (best quality) or openai/gpt-oss-20b (fastest/cheapest)
#              -> see current list: https://console.groq.com/docs/models
# openrouter:  e.g. anthropic/claude-sonnet-4-6, openai/gpt-4.1, meta-llama/llama-3.3-70b-instruct,
#              or a free model like meta-llama/llama-3.1-8b-instruct:free
#              -> see full catalog + pricing: https://openrouter.ai/models
LLM_MODEL=claude-sonnet-4-6

# ── API keys — only set the one matching LLM_PROVIDER above ─────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GROQ_API_KEY=your-groq-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional, OpenRouter only — used for their public leaderboard attribution.
# Safe to leave blank.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=PrepAI

# ── Everything below is unrelated to the LLM provider ────────────────
DATABASE_URL=sqlite:///./prepai.db
# For Postgres instead, use e.g.:
# DATABASE_URL=postgresql://prepai:prepai@localhost:5432/prepai
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
UPLOAD_DIR=./uploads
